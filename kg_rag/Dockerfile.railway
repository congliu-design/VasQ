FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY kg_rag/requirements.prod.txt /app/requirements.prod.txt
RUN pip install --upgrade pip && pip install -r requirements.prod.txt

COPY kg_rag/ /app/

CMD bash -lc 'gunicorn api:app --bind 0.0.0.0:${PORT:-5005} --workers 1 --threads 4 --timeout 300'
